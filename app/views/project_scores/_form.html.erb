<%= form_for [@team, @projectscore] do |f| %>
    <%= errors_for(@projectscore) %>
        <p>Judge:
            <%= f.text_field :judge_name %>
        </p>
        <p style="color:red">* Required for Award Consideration</p>
        <table class="grid">
        <tr style="border: none;">
            <td style="background-color: #E9ECF7">
                <b>Beginning</b><br>1
            </td>
            <td style="background-color: #BEC8E5">
                <b>Developing</b><br>2
            </td>
            <td style="background-color: #90A3D0">
                <b>Accomplished</b><br>3
            </td>
            <td style="background-color: #5F83BF">
                <b>Exceeds</b><br>4<br><b><i>How has the team exceeded?</i></b>
            </td>
        </tr>

        <tr>
            <td class="altPR">
                <b>IDENTIFY</b>
            </td>
            <td class="altPR" colspan="3">
              	Team had a clearly defined problem that was well researched.
            </td>
        </tr>
        <tr>
            <td>
                <%= f.radio_button :identify, "1" %>
                <%= f.label :identify, "Unclear definition of the problem", :value => "1" %>
            </td>
            <td>
                <%= f.radio_button :identify, "2" %>
                <%= f.label :identify, "Partially clear definition of the problem", :value => "2" %>
            </td>
            <td>
                <%= f.radio_button :identify, "3" %>
                <%= f.label :identify, "Clear definition of the problem", :value => "3" %>
            </td>
            <td>
                <%= f.radio_button :identify, "4" %>
                <%= f.label :identify, "", :value => "4" %>
                <%= f.text_area :identify_exceed %>
            </td>
        </tr>
        <tr>
            <td>
                <%= f.radio_button :identify2, "1" %>
                <%= f.label :identify2, "Minimal evidence of research", :value => "1" %>
            </td>
            <td>
                <%= f.radio_button :identify2, "2" %>
                <%= f.label :identify2, "Partial evidence of research from one or more sources", :value => "2" %>
            </td>
            <td>
                <%= f.radio_button :identify2, "3" %>
                <%= f.label :identify2, "Clear, detailed research from a variety of sources", :value => "3" %>
            </td>
            <td>
                <%= f.radio_button :identify2, "4" %>
                <%= f.label :identify2, "", :value => "4" %>
                <%= f.text_area :identify2_exceed %>
            </td>
        </tr>

        <tr>
            <td class="altPR">
                <b>DESIGN</b>
            </td>
            <td class="altPR" colspan="3">
              	Team worked together while creating a project plan and developing their ideas.
            </td>
        </tr>
        <tr>
            <td>
                <%= f.radio_button :design, "1" %>
                <%= f.label :design, "Minimal evidence of an effective project plan", :value => "1" %>
            </td>
            <td>
                <%= f.radio_button :design, "2" %>
                <%= f.label :design, "Partial evidence of an effective project plan", :value => "2" %>
            </td>
            <td>
                <%= f.radio_button :design, "3" %>
                <%= f.label :design, "Clear evidence of an effective project plan", :value => "3" %>
            </td>
            <td>
                <%= f.radio_button :design, "4" %>
                <%= f.label :design, "", :value => "4" %>
                <%= f.text_area :design_exceed %>
            </td>
        </tr>
        <tr>
            <td>
                <%= f.radio_button :design2, "1" %>
                <%= f.label :design2, "Minimal evidence that development process involved all team members", :value => "1" %>
            </td>
            <td>
                <%= f.radio_button :design2, "2" %>
                <%= f.label :design2, "Partial evidence that development process involved all team members", :value => "2" %>
            </td>
            <td>
                <%= f.radio_button :design2, "3" %>
                <%= f.label :design2, "Clear evidence that development process involved all team members", :value => "3" %>
            </td>
            <td>
                <%= f.radio_button :design2, "4" %>
                <%= f.label :design2, "", :value => "4" %>
                <%= f.text_area :design2_exceed %>
            </td>
        </tr>

        <tr>
            <td class="altPR">
                <b>CREATE</b>
            </td>
            <td class="altPR" colspan="3">
              	Team developed an original idea or built on an existing one with a prototype model/drawing to represent their solution.
            </td>
        </tr>
        <tr>
            <td>
                <%= f.radio_button :create, "1" %>
                <%= f.label :create, "Minimal explanation of innovation in solution", :value => "1" %>
            </td>
            <td>
                <%= f.radio_button :create, "2" %>
                <%= f.label :create, "Simple explanation of innovation in solution", :value => "2" %>
            </td>
            <td>
                <%= f.radio_button :create, "3" %>
                <%= f.label :create, "Detailed explanation of innovation in solution", :value => "3" %>
            </td>
            <td>
                <%= f.radio_button :create, "4" %>
                <%= f.label :create, "", :value => "4" %>
                <%= f.text_area :create_exceed %>
            </td>
        </tr>
        <tr>
            <td>
                <%= f.radio_button :create2, "1" %>
                <%= f.label :create2, "Unclear model/drawing that represents the solution", :value => "1" %>
            </td>
            <td>
                <%= f.radio_button :create2, "2" %>
                <%= f.label :create2, "Simple model/drawing that represents the solution", :value => "2" %>
            </td>
            <td>
                <%= f.radio_button :create2, "3" %>
                <%= f.label :create2, "Detailed model/drawing that represents the solution", :value => "3" %>
            </td>
            <td>
                <%= f.radio_button :create2, "4" %>
                <%= f.label :create2, "", :value => "4" %>
                <%= f.text_area :create2_exceed %>
            </td>
        </tr>
       <tr>
            <td class="altPR">
                <b>ITERATE</b>
            </td>
            <td class="altPR" colspan="3">
              	Team shared their ideas with others, collected feedback, and included improvements to their solution.
            </td>
        </tr>
        <tr>
            <td>
                <%= f.radio_button :iterate, "1" %>
                <%= f.label :iterate, "Minimal sharing of their solution with others", :value => "1" %>
            </td>
            <td>
                <%= f.radio_button :iterate, "2" %>
                <%= f.label :iterate, "Solution shared with at least one person/group", :value => "2" %>
            </td>
            <td>
                <%= f.radio_button :iterate, "3" %>
                <%= f.label :iterate, "Solution shared with multiple people/groups", :value => "3" %>
            </td>
            <td>
                <%= f.radio_button :iterate, "4" %>
                <%= f.label :iterate, "", :value => "4" %>
                <%= f.text_area :iterate_exceed %>
            </td>
        </tr>
        <tr>
            <td>
                <%= f.radio_button :iterate2, "1" %>
                <%= f.label :iterate2, "Minimal evidence of improvements based on feedback", :value => "1" %>
            </td>
            <td>
                <%= f.radio_button :iterate2, "2" %>
                <%= f.label :iterate2, "Partial evidence of improvements based on feedback", :value => "2" %>
            </td>
            <td>
                <%= f.radio_button :iterate2, "3" %>
                <%= f.label :iterate2, "Clear evidence of improvements based on feedback", :value => "3" %>
            </td>
            <td>
                <%= f.radio_button :iterate2, "4" %>
                <%= f.label :iterate2, "", :value => "4" %>
                <%= f.text_area :iterate2_exceed %>
            </td>
        </tr>

              <tr>
            <td class="altPR">
                <b>COMMUNICATE</b>
            </td>
            <td class="altPR" colspan="3">
              	Team shared an effective presentation of their solution, its impact on others, and celebrated their team's progress.
            </td>
        </tr>
        <tr>
            <td>
                <%= f.radio_button :communicate, "1" %>
                <%= f.label :communicate, "Unclear explanation of the solution and its potential impact on others", :value => "1" %>
            </td>
            <td>
                <%= f.radio_button :communicate, "2" %>
                <%= f.label :communicate, "Partially clear explanation of solution and its potential impact on others", :value => "2" %>
            </td>
            <td>
                <%= f.radio_button :communicate, "3" %>
                <%= f.label :communicate, "Clear explanation of solution and its potential impact on others", :value => "3" %>
            </td>
            <td>
                <%= f.radio_button :communicate, "4" %>
                <%= f.label :communicate, "", :value => "4" %>
                <%= f.text_area :communicate_exceed %>
            </td>
        </tr>
        <tr>
            <td>
                <%= f.radio_button :communicate2, "1" %>
                <%= f.label :communicate2, "Presentation shows minimal pride or enthusiasm for their work", :value => "1" %>
            </td>
            <td>
                <%= f.radio_button :communicate2, "2" %>
                <%= f.label :communicate2, "Presentation shows partial pride or enthusiasm for their work", :value => "2" %>
            </td>
            <td>
                <%= f.radio_button :communicate2, "3" %>
                <%= f.label :communicate2, "Presentation clearly shows pride or enthusiasm for their work", :value => "3" %>
            </td>
            <td>
                <%= f.radio_button :communicate2, "4" %>
                <%= f.label :communicate2, "", :value => "4" %>
                <%= f.text_area :communicate2_exceed %>
            </td>
        </tr>
    </table>
<!-------------------------------------------------->

    <table>
        <tr><th class="altPR comments">Great Job...</th><th class="altPR comments">Think About...</th></tr>
        <tr>
            <td><%= f.text_area :p_gj_comments, :rows => 5, :cols => 80 %></td>
            <td><%= f.text_area :p_ta_comments, :rows => 5, :cols => 80 %></td>
        </tr>
    </table>
        <p>
            <%= f.submit "Submit" %>
        </p>
        <% end %>
