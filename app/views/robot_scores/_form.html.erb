<%= form_for [@team, @robotscore] do |f| %>
  <%= errors_for(@robotscore) %>
<p>Judge: <%= f.text_field :judge_name %></p>

<table class="grid">
    <tr style="border: none;">
        <td style="background-color: #EDF4ED">
            <b>Beginning</b><br>1
        </td>
        <td style="background-color: #C6DEC6">
            <b>Developing</b><br>2
        </td>
        <td style="background-color: #9AC69D">
            <b>Accomplished</b><br>3
        </td>
        <td style="background-color: #64AF75">
            <b>Exceeds</b><br>4<br><b><i>How has the team exceeded?</i></b>
        </td>
    </tr>

         <tr>
            <td class="altRC">
                <b>IDENTIFY</b>
            </td>
            <td class="altRC" colspan="3">
              	Team determined which missions to attempt, explored building and coding resources, and sought guidance as needed.
            </td>
        </tr>
        <tr>
            <td>
                <%= f.radio_button :identify, "1" %>
                <%= f.label :identify, "Minimal evidence of mission strategy", :value => "1" %>
            </td>
            <td>
                <%= f.radio_button :identify, "2" %>
                <%= f.label :identify, "Partial evidence of mission strategy", :value => "2" %>
            </td>
            <td>
                <%= f.radio_button :identify, "3" %>
                <%= f.label :identify, "Clear evidence of mission strategy", :value => "3" %>
            </td>
            <td>
                <%= f.radio_button :identify, "4" %>
                <%= f.label :identify, "", :value => "4" %>
                <%= f.text_area :identify_exceed %>
            </td>
        </tr>
        <tr>
            <td>
                <%= f.radio_button :identify2, "1" %>
                <%= f.label :identify2, "Minimal use of building or coding resources", :value => "1" %>
            </td>
            <td>
                <%= f.radio_button :identify2, "2" %>
                <%= f.label :identify2, "Some use of building or coding resources", :value => "2" %>
            </td>
            <td>
                <%= f.radio_button :identify2, "3" %>
                <%= f.label :identify2, "Clear use of building or coding resources to support their mission strategy", :value => "3" %>
            </td>
            <td>
                <%= f.radio_button :identify2, "4" %>
                <%= f.label :identify2, "", :value => "4" %>
                <%= f.text_area :identify2_exceed %>
            </td>
        </tr>

        <tr>
            <td class="altRC">
                <b>DESIGN</b>
            </td>
            <td class="altRC" colspan="3">
              	Team members worked collaboratively on their designs and developed the building and coding skills needed.
            </td>
        </tr>
        <tr>
            <td>
                <%= f.radio_button :design, "1" %>
                <%= f.label :design, "MMinimal evidence that all team members contributed ideas", :value => "1" %>
            </td>
            <td>
                <%= f.radio_button :design, "2" %>
                <%= f.label :design, "Partial evidence that all team members contributed ideas", :value => "2" %>
            </td>
            <td>
                <%= f.radio_button :design, "3" %>
                <%= f.label :design, "Clear evidence that all team members contributed ideas", :value => "3" %>
            </td>
            <td>
                <%= f.radio_button :design, "4" %>
                <%= f.label :design, "", :value => "4" %>
                <%= f.text_area :design_exceed %>
            </td>
        </tr>
        <tr>
            <td>
                <%= f.radio_button :design2, "1" %>
                <%= f.label :design2, "Minimal evidence of building and coding skills in all team members", :value => "1" %>
            </td>
            <td>
                <%= f.radio_button :design2, "2" %>
                <%= f.label :design2, "PPartial evidence of building and coding skills in all team members", :value => "2" %>
            </td>
            <td>
                <%= f.radio_button :design2, "3" %>
                <%= f.label :design2, "Clear evidence of building and coding skills in all team members", :value => "3" %>
            </td>
            <td>
                <%= f.radio_button :design2, "4" %>
                <%= f.label :design2, "", :value => "4" %>
                <%= f.text_area :design2_exceed %>
            </td>
        </tr>

        <tr>
            <td class="altRC">
                <b>CREATE</b>
            </td>
            <td class="altRC" colspan="3">
              	Team developed original designs or improved on existing ones according to their mission strategy.
            </td>
        </tr>
         <tr>
            <td>
                <%= f.radio_button :create, "1" %>
                <%= f.label :create, "Unclear explanation of attachments and their purpose", :value => "1" %>
            </td>
            <td>
                <%= f.radio_button :create, "2" %>
                <%= f.label :create, "Simple explanation of attachments and their purpose", :value => "2" %>
            </td>
            <td>
                <%= f.radio_button :create, "3" %>
                <%= f.label :create, "Clear explanation of innovative attachments and their purpose", :value => "3" %>
            </td>
            <td>
                <%= f.radio_button :create, "4" %>
                <%= f.label :create, "", :value => "4" %>
                <%= f.text_area :create_exceed %>
            </td>
        </tr>
        <tr>
            <td>
                <%= f.radio_button :create2, "1" %>
                <%= f.label :create2, "Unclear explanation of code and/or sensor use", :value => "1" %>
            </td>
            <td>
                <%= f.radio_button :create2, "2" %>
                <%= f.label :create2, "Simple explanation of code and/or sensor use", :value => "2" %>
            </td>
            <td>
                <%= f.radio_button :create2, "3" %>
                <%= f.label :create2, "Clear explanation of innovative code and/or sensor use", :value => "3" %>
            </td>
            <td>
                <%= f.radio_button :create2, "4" %>
                <%= f.label :create2, "", :value => "4" %>
                <%= f.text_area :create2_exceed %>
            </td>
        </tr>
       <tr>
            <td class="altRC">
                <b>ITERATE</b>
            </td>
            <td class="altRC" colspan="3">
              	Team repeatedly tested their robot and code to identify areas for improvement and incorporated the findings into their solutions.
            </td>
        </tr>
        <tr>
            <td>
                <%= f.radio_button :iterate, "1" %>
                <%= f.label :iterate, "Minimal evidence of testing their robot and code", :value => "1" %>
            </td>
            <td>
                <%= f.radio_button :iterate, "2" %>
                <%= f.label :iterate, "Partial evidence of testing their robot and code", :value => "2" %>
            </td>
            <td>
                <%= f.radio_button :iterate, "3" %>
                <%= f.label :iterate, "Clear evidence of testing their robot and code", :value => "3" %>
            </td>
            <td>
                <%= f.radio_button :iterate, "4" %>
                <%= f.label :iterate, "", :value => "4" %>
                <%= f.text_area :iterate_exceed %>
            </td>
        </tr>
        <tr>
            <td>
                <%= f.radio_button :iterate2, "1" %>
                <%= f.label :iterate2, "Minimal evidence of improvements based on testing", :value => "1" %>
            </td>
            <td>
                <%= f.radio_button :iterate2, "2" %>
                <%= f.label :iterate2, "Partial evidence of improvements based on testing", :value => "2" %>
            </td>
            <td>
                <%= f.radio_button :iterate2, "3" %>
                <%= f.label :iterate2, "Clear evidence of improvements based on testing", :value => "3" %>
            </td>
            <td>
                <%= f.radio_button :iterate2, "4" %>
                <%= f.label :iterate2, "", :value => "4" %>
                <%= f.text_area :iterate2_exceed %>
            </td>
        </tr>

              <tr>
            <td class="altRC">
                <b>COMMUNICATE</b>
            </td>
            <td class="altRC" colspan="3">
              	Team effectively explained what they learned from the robot design process and celebrated their progress.
            </td>
        </tr>
        <tr>
            <td>
                <%= f.radio_button :communicate, "1" %>
                <%= f.label :communicate, "Unclear explanation of process and lessons learned", :value => "1" %>
            </td>
            <td>
                <%= f.radio_button :communicate, "2" %>
                <%= f.label :communicate, "Simple explanation of process and lessons learned", :value => "2" %>
            </td>
            <td>
                <%= f.radio_button :communicate, "3" %>
                <%= f.label :communicate, "Detailed explanation of process and lessons learned", :value => "3" %>
            </td>
            <td>
                <%= f.radio_button :communicate, "4" %>
                <%= f.label :communicate, "", :value => "4" %>
                <%= f.text_area :communicate_exceed %>
            </td>
        </tr>
        <tr>
            <td>
                <%= f.radio_button :communicate2, "1" %>
                <%= f.label :communicate2, "Team shows minimal pride or enthusiasm for their work", :value => "1" %>
            </td>
            <td>
                <%= f.radio_button :communicate2, "2" %>
                <%= f.label :communicate2, "Team shows partial pride or enthusiasm for their work", :value => "2" %>
            </td>
            <td>
                <%= f.radio_button :communicate2, "3" %>
                <%= f.label :communicate2, "Team clearly shows pride or enthusiasm for their work", :value => "3" %>
            </td>
            <td>
                <%= f.radio_button :communicate2, "4" %>
                <%= f.label :communicate2, "", :value => "4" %>
                <%= f.text_area :communicate2_exceed %>
            </td>
        </tr>
    </table>

    <table>
        <tr><th class="altRC comments">Great Job...</th><th class="altRC comments">Think About...</th></tr>
        <tr>
            <td><%= f.text_area :r_gj_comments, :rows => 5, :cols => 80 %></td>
            <td><%= f.text_area :r_ta_comments, :rows => 5, :cols => 80 %></td>
        </tr>
    </table>
  <p><%= f.submit "Submit" %></p>
<% end %>
